filters:
  and:
    - file.inFolder("health/nutrition/ingredients")
    - 'note.type == "ingredient"'
properties:
  file.name:
    displayName: Ingredient
  note.category:
    displayName: Category
  note.smoothie_status:
    displayName: Smoothie status
views:
  - type: table
    name: Ingredients
    order:
      - file.name
      - note.category
      - note.smoothie_status
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Tried
    filters:
      and:
        - 'note.smoothie_status == "tried"'
    order:
      - file.name
      - note.category
      - note.smoothie_status
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Candidates
    filters:
      and:
        - 'note.smoothie_status == "candidate"'
    order:
      - file.name
      - note.category
      - note.smoothie_status
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Deferred
    filters:
      and:
        - 'note.smoothie_status == "deferred"'
    order:
      - file.name
      - note.category
      - note.smoothie_status
    sort:
      - property: file.name
        direction: ASC
